<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- IDENTIFICADOR: é esse nome que vai no código Java -->
    <persistence-unit name="gerenciamento_usuario">

        <class>br.com.ifba.pessoa.entity.Pessoa</class>
        <class>br.com.ifba.pessoa.entity.Cliente</class>
        <class>br.com.ifba.pessoa.entity.Barbeiro</class>
        <class>br.com.ifba.pessoa.entity.Admin</class>
        <class>br.com.ifba.usuario.entity.Perfil</class>
        <class>br.com.ifba.usuario.entity.Usuario</class>

        <properties>
            <!-- DADOS DA CONEXÃO (preencha user e password no seu persistence.xml local) -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/prg03_usuario?createDatabaseIfNotExist=true&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value=""/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!-- PROPRIEDADES DO HIBERNATE -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
        </properties>
    </persistence-unit>
</persistence>